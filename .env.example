# Copy to .env and replace every CHANGE_ME value before starting the application.
NOTES_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD
NOTES_RUNTIME_PASSWORD=CHANGE_ME_RUNTIME_PASSWORD
NOTES_DATABASE_URL=postgresql+psycopg://notes_runtime:CHANGE_ME@db:5432/notes
NOTES_MIGRATION_DATABASE_URL=postgresql+psycopg://notes_migrator:CHANGE_ME@db:5432/notes
NOTES_SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
NOTES_CSRF_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
NOTES_COOKIE_SECURE=false
NOTES_ALLOWED_ORIGIN=http://localhost:8000
NOTES_HOST_PORT=8000
NOTES_OLLAMA_URL=http://ollama:11434
NOTES_EMBEDDING_MODEL=embeddinggemma:300m
NOTES_EMBEDDING_MODEL_DIGEST=85462619ee72
NOTES_GENERATION_MODEL=llama3:latest
NOTES_GENERATION_MODEL_ID=365c0bd3c000
NOTES_RETRIEVAL_LIMIT=5
NOTES_RETRIEVAL_MINIMUM_SIMILARITY=0.55
NOTES_WORKER_POLL_SECONDS=1
NOTES_WORKER_LEASE_SECONDS=60
